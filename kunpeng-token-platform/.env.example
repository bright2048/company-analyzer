# ============================================
# 鲲鹏Token汇聚平台 - 环境变量配置
# 复制此文件为 .env 并修改配置
# ============================================

# 服务监听地址
APP_ADDR=0.0.0.0:8080

# 平台管理员令牌（务必修改为强密码！）
PLATFORM_ADMIN_TOKEN=kp-admin-change-me-to-strong-token

# 存储后端: memory (开发/测试) 或 sqlite (生产)
STORAGE_BACKEND=memory

# 数据库连接（当STORAGE_BACKEND=sqlite时使用）
# DATABASE_URL=./data/kunpeng.db

# 前端静态文件目录
STATIC_DIR=./static

# 日志级别: debug, info, warn, error
LOG_LEVEL=info
