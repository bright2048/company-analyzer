}

interface QccInvestmentThroughItem {
  KeyNo: string;
  Name: string;
  CreditCode: string;
  CorpStatus: string;
  TotalStockPercent: string;
  DetailInfoList: QccInvestmentDetailInfo[];
}

interface QccInvestmentDetailInfo {
  Level: string;
  ShouldCapi: string;
